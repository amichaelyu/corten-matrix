@@ -1356,3 +1364,18 @@
         Ok(headers)
     }
 }
+
+// Set when the bridge runs without iCloud features (disable_icloud_contacts):
+// nothing then needs a fresh account token, so get_token never starts an
+// automatic GSA login. Manual logins don't go through get_token.
+static TOKEN_REFRESH_DISABLED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Turn automatic token refreshes (GSA logins) off or on for this process.
+pub fn set_token_refresh_disabled(disabled: bool) {
+    TOKEN_REFRESH_DISABLED.store(disabled, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// True when automatic token refreshes are turned off by configuration.
+pub fn token_refresh_disabled() -> bool {
+    TOKEN_REFRESH_DISABLED.load(std::sync::atomic::Ordering::Relaxed)
+}
